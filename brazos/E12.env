# Brazo E12 (v4): E11 con las copias X * 1 y los padres AL AZAR (control de E11).
# Misma RAM que E11.
# Grupo B: final train hasta 202105 y ganancia con la clase real de 202107, sin Kaggle.
# Lo corre brazos/correr_brazos.sh, una corrida por semilla del pipeline.
GRUPO=B
EXPERIMENTO=9932
BUCKET_DIR=/home/ds/buckets/b1
DATASET_PATH=/home/ds/buckets/b1/datasets/analistasr_competencia_2026.csv.gz

# sin mail (MAIL_TO_FILE vacio: el script loguea "SIN MAIL" y sigue). Para recibirlos, poner los del .env
MAIL_FROM=sin-mail
MAIL_PASS_FILE=/dev/null
MAIL_TO_FILE=/dev/null
KAGGLE_SUBIR=0

# lo mismo en todos los brazos: la BO no es lo que se compara. HT_FIJO es la BO de WF9600
# (base z635 grupo B, 30 iteraciones) en nuestro bucket: en otro bucket, apuntar a un
# BO_log.txt propio o dejarla vacia (corre la BO). Final train con 3 semillas y
# 20% de los CONTINUA, como entreno la BO. La importancia del evolutivo sale del
# LightGBM de canaritos, no de esta BO. Ojo: WF9600 se hizo con ~450 columnas (despues
# de canaritos) y estos brazos ven 1.500 a 4.500: para comparar justo contra E5 conviene
# una BO hecha sobre E5 y usarla en E5, E10, E11 y E12
HT_FIJO=/home/ds/buckets/b1/exp/WF9600/BO_log.txt
FT_SEMILLAS_N=3
FT_UNDERSAMPLING=0.2

GA_MODO=evolutivo
EV_SELECCION=azar
EV_GENERACIONES=10
EV_ORIGINALES_FIJAS=1
EV_FORMULAS=500
EV_MIN_HIJOS=0.1
EV_HISTORIA=1
EV_PISO_CANARITOS=1
EV_UNDERSAMPLING=1
